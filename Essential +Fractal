// ---------------------------- MACRO TIMES (New York time) ----------------------------
// minutes since midnight NY: 19:50-20:10, 02:33-03:00, 04:03-04:30, 08:50-09:10, 09:50-10:10, 10:50-11:10, 11:50-12:10, 13:10-13:40, 15:15-15:45
var array<int> macroFrom = array.from(1190, 153, 243, 530, 590, 650, 710, 790, 915)
var array<int> macroTo   = array.from(1210, 180, 270, 550, 610, 670, 730, 820, 945)

f_nyMin(int t) => hour(t, "America/New_York") * 60 + minute(t, "America/New_York")

// Hourly macro: last 10 min of every hour + first 10 min of the next (xx:50 - xx:10), plus the fixed windows above
f_isMacro(int t) =>
    bool r = false
    if not na(t)
        int m  = f_nyMin(t)
        int mm = m % 60
        if mm >= 50 or mm <= 10
            r := true
        else
            for i = 0 to macroFrom.size() - 1
                if m >= macroFrom.get(i) and m <= macroTo.get(i)
                    r := true
                    break
    r

// ICT killzones (New York time): Asia 20:00-00:00, London 02:00-05:00, NY AM 07:00-10:00, NY PM 13:30-16:00. Returns "" when outside.
f_killzone(int t) =>
    string z = ""
    if not na(t)
        int m = f_nyMin(t)
        if m >= 1200
            z := "Asia"
        else if m >= 120 and m < 300
            z := "London"
        else if m >= 420 and m < 600
            z := "NY AM"
        else if m >= 810 and m < 960
            z := "NY PM"
    z

// ---------------------------- HTF FVG ----------------------------
// [MERGED] The dashboard no longer makes its own HTF FVG request: it reads the FVG list built by the HTF FVG engine
// (Part 2, activeFVGs). Same HTF mapping, so one request instead of two.
// Reaction = C2 wicked into a same-direction HTF FVG that already existed before C2 opened, without closing through it.
f_htfFvgHit(bool bull, float c2L, float c2H, int c2Open, int sweepBar) =>
    bool hit = false
    int span = math.min(bar_index - sweepBar, 500)
    for f in activeFVGs
        if f.isBullish == bull and not na(f.doneT)
            // (a) the C2 candle traded into an FVG that was already complete when C2 opened
            if f.doneT <= c2Open and c2L <= f.top and c2H >= f.bottom
                hit := true
            // (b) any chart bar from the C2 sweep until now traded into the FVG after it was complete
            if not hit and span >= 0
                for m = 0 to span
                    // Bars are visited newest-to-oldest; older bars cannot qualify after this point.
                    if time[m] < f.doneT
                        break
                    if low[m] <= f.top and high[m] >= f.bottom
                        hit := true
                        break
            if hit
                break
    hit

f_dbLive() =>
    C2Setup r = na
    bool a = not na(buySetup) and not buySetup.dead and buySetup.phase != 0
    bool b = not na(sellSetup) and not sellSetup.dead and sellSetup.phase != 0
    if a and b
        r := buySetup.c2BarIndex > sellSetup.c2BarIndex ? buySetup : sellSetup
    else if a
        r := buySetup
    else if b
        r := sellSetup
    r

