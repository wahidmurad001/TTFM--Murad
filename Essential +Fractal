// (periodChanged / ch2 / ch3), so index j lines up 1:1.
// Highs / lows come from the shared security calls (pairH / pairL / pair2H / pair2L).
f_corrMaintain(CorrSeries s, bool active, bool changed, int maxCount, float h, float l) =>
    if active
        if changed
            s.hi.unshift(h)
            s.lo.unshift(l)
            while s.hi.size() > maxCount
                s.hi.pop()
                s.lo.pop()
        else if s.hi.size() > 0
            if not na(h)
                s.hi.set(0, na(s.hi.first()) ? h : math.max(s.hi.first(), h))
            if not na(l)
                s.lo.set(0, na(s.lo.first()) ? l : math.min(s.lo.first(), l))
    true

