method update(HtfCandle c, float curH, float curL, float curC, int curBar) =>
    if curH > c.h
        c.h    := curH
        c.hBar := curBar
    if curL < c.l
        c.l    := curL
        c.lBar := curBar
    c.c := curC
    c

// k = 0/1/2 selects the per-HTF settings. Drawing objects are created on first draw.
method draw(HtfCandle c, int leftBar, int k, string tf = "") =>
    bool  isBull = c.c >= c.o
    int   midX   = leftBar + 1
    float eq     = (c.h + c.l) / 2
    float bt     = math.max(c.o, c.c)
    float bb     = math.min(c.o, c.c)
    color wc     = isBull ? wickBulls.get(k) : wickBears.get(k)
    if na(c.body)
        c.body     := box.new(leftBar, bt, leftBar + 2, bb, border_color = color.gray, border_width = 1, force_overlay = true)
        c.wickUp   := line.new(midX, c.h, midX, bt, color = wc, force_overlay = true)
        c.wickDown := line.new(midX, c.l, midX, bb, color = wc, force_overlay = true)
        c.eqLine   := line.new(midX, eq, midX, eq, color = noColor, force_overlay = true)
    box.set_left(c.body, leftBar)
    box.set_right(c.body, leftBar + 2)
    box.set_top(c.body, bt)
    box.set_bottom(c.body, bb)
    box.set_bgcolor(c.body, isBull ? bullBodies.get(k) : bearBodies.get(k))
    box.set_border_color(c.body, isBull ? borderBulls.get(k) : borderBears.get(k))
    line.set_xy1(c.wickUp, midX, c.h)
    line.set_xy2(c.wickUp, midX, bt)
    line.set_color(c.wickUp, wc)
    line.set_xy1(c.wickDown, midX, c.l)
    line.set_xy2(c.wickDown, midX, bb)
    line.set_color(c.wickDown, wc)
    line.set_xy1(c.eqLine, midX, eq)
    line.set_xy2(c.eqLine, midX, eq)
    line.set_color(c.eqLine, eqLineColor())
    line.set_style(c.eqLine, lineStyleFromStr(eqStyle))
    line.set_width(c.eqLine, eqWidth)
    c.midX := midX
    string tt = (tf == "" or timeframe.in_seconds(tf) >= timeframe.in_seconds("1D")) ? str.upper(str.format_time(c.openTime + 43200000, "EEE", "America/New_York")) : str.format_time(c.openTime, "HH:mm", "America/New_York")

    // [TAGS] bullish tags share the below-candle slot with the time stamp, so merge them when stamps are on
    bool roleOn   = c123Show and c123Ons.get(k) and showLabels
    bool mergeBuy = roleOn and showStamps.get(k) and not na(c.buyRole)
    string stampTxt = mergeBuy ? c.buyRole + "\n" + tt : tt
    if showStamps.get(k)
        if na(c.timeLbl)
            c.timeLbl := label.new(midX, c.l, stampTxt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = na, textcolor = infoCols.get(k), size = textSize(lblSizes.get(k)), text_font_family = font.family_default, force_overlay = true)
        else
            label.set_xy(c.timeLbl, midX, c.l)
            label.set_text(c.timeLbl, stampTxt)
    else
        label.delete(c.timeLbl)
        c.timeLbl := na

    // bullish: below the candle low (standalone only when not merged into the stamp)
    if roleOn and not na(c.buyRole) and not mergeBuy
        c.buyLbl := roleLabel(c.buyLbl, midX, c.l, c.buyRole, c.buyClr, true)
    else if not na(c.buyLbl)
        label.delete(c.buyLbl)
        c.buyLbl := na

    // bearish: above the candle high
    if roleOn and not na(c.sellRole)
        c.sellLbl := roleLabel(c.sellLbl, midX, c.h, c.sellRole, c.sellClr, false)
    else if not na(c.sellLbl)
        label.delete(c.sellLbl)
        c.sellLbl := na
    c

