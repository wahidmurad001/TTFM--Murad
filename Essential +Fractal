// ---------------------------------- TYPES ----------------------------------
type HtfCandle
    float o
    float h
    float l
    float c
    int   hBar
    int   lBar
    int   startBar
    // drawing objects are created lazily by draw() (only candles that are actually drawn get them)
    box   body
    line  wickUp
    line  wickDown
    line  eqLine
    int   midX
    line  sweepLine   = na
    bool  triggerBuy  = false
    bool  triggerSell = false
    int   openTime    = na
    label timeLbl     = na
    // [TAGS] one slot per direction so a candle can be e.g. bull C2 and bear C3 at once
    string buyRole    = na
    string sellRole   = na
    color  buyClr     = na
    color  sellClr    = na
    label  buyLbl     = na
    label  sellLbl    = na
    // [PAIR] SMT-pair (p*) and PSP-symbol (q*) values accumulated over this HTF candle
    float  pO         = na
    float  pH         = na
    float  pL         = na
    float  pC         = na
    float  qO         = na
    float  qC         = na

type PeriodState
    float prevHigh        = na
    float prevLow         = na
    int   prevHighBar     = na
    int   prevLowBar      = na
    float prevPrevHigh    = na
    float prevPrevLow     = na
    int   prevPrevHighBar = na
    int   prevPrevLowBar  = na
    bool  prevC2Buy       = false
    bool  prevC2Sell      = false

type ICCisd
    float extremePrice
    bool  taken    = false
    label dotLbl   = na
    bool  isBull   = false
    int   takenBar = na

type C2Setup
    bool  isBull
    float extreme
    int   phase     = 1
    bool  dead      = false
    label c2Lbl
    int   c2BarIndex    = na
    box   c3Box     = na
    line  c3Dash    = na
    label c3Lbl     = na
    float cisdLevel     = na
    int   cisdIndex     = na
    bool  cisdConfirmed = false
    int   cisdEndIndex  = na
    array<label> devLbls = na
    // c4Box / c4Dash / c4Lbl / c4Top / c4Bottom always hold the CURRENT stage >= 4 box (C4, C5 or C6)
    box   c4Box     = na
    line  c4Dash    = na
    label c4Lbl     = na
    float c4Top     = na
    float c4Bottom  = na
    bool  c4Invalid = false
    float c3Extreme = na
    // IC-CISD
    array<ICCisd> icList = na
    bool  icPending       = false
    float icLevel         = na
    int   icStartIndex    = na
