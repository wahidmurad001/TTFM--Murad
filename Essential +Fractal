type Track
    float curH
    int   curHt
    float curL
    int   curLt
    float pH
    int   pHt
    float pL
    int   pLt
    int   periods = 0

method update(Track t, bool newP) =>
    if na(t.curH) or newP
        if not na(t.curH)
            t.pH  := t.curH
            t.pHt := t.curHt
            t.pL  := t.curL
            t.pLt := t.curLt
            t.periods += 1
        t.curH  := high
        t.curHt := time
        t.curL  := low
        t.curLt := time
    else
        if high > t.curH
            t.curH  := high
            t.curHt := time
        if low < t.curL
            t.curL  := low
            t.curLt := time

type Tagger
    float lvl
    int   tag

method step(Tagger g, float level, bool isHigh) =>
    if not (level == g.lvl)
        g.lvl := level
        g.tag := na
    if not na(level) and na(g.tag)
        if isHigh ? high >= level : low <= level
            g.tag := time

