            if showFVGBoxes
                b := box.new(leftT, top, time + getRightExtension(), bot, bgcolor = bull ? bullishFVGColor : bearishFVGColor, border_color = color.new(color.gray, 100), xloc = xloc.bar_time, force_overlay = true)
                if showMidlines
                    l := line.new(leftT, midPrice, time + getRightExtension(), midPrice, color = midlineColor, style = line_style(midlineStyle), width = midlineWidth, xloc = xloc.bar_time, force_overlay = true)
