drawLvl(float price, int startTime, int tagTime, string nm, color c, int w, string sty, string sz, string pos, bool en) =>
    bool tagged = not na(tagTime)
    if en and not na(price) and not na(startTime) and not (tagged and tagMode == "Remove line")
        int stepMs = timeframe.in_seconds() * 1000
        string txt = showPriceInLabel ? nm + "  " + str.tostring(price, format.mintick) : nm
        int endT = tagged ? tagTime : time + stepMs * extBars
        bool atStart = pos == "Top Left" or pos == "Bottom Left"
        int lblT = pos == "Right" ? endT + stepMs * lblGap : atStart ? startTime : endT
        line l = line.new(startTime, price, endT, price, xloc=xloc.bar_time, color=c, style=getLineStyle(sty), width=w, force_overlay=true)
        label lbl = na
        if lvlPt > 0
            lbl := label.new(lblT, price, txt, xloc=xloc.bar_time, style=lblStyleOf(pos), textcolor=c, size=lvlPt, color=hNoColor, force_overlay=true)
        else
            lbl := label.new(lblT, price, txt, xloc=xloc.bar_time, style=lblStyleOf(pos), textcolor=c, size=htfSize(sz), color=hNoColor, force_overlay=true)
        sessionLines.push(l)
        sessionLabels.push(lbl)

// [FIX] key levels are rebuilt on the last bar of every update.
// The old guard (var int lastKeyDraw = na; if barstate.islast and lastKeyDraw != bar_index) compared an na int with !=,
// which can stay false, so the whole block never ran and no level (PDH/PDL/PWH/PWL/PMH/PML, opens, ATH) was drawn.
// Deleting and re-creating ~11 lines + labels once per update is cheap, so no guard is needed.
if barstate.islast
    for l in sessionLines
        line.delete(l)
    for lb in sessionLabels
        label.delete(lb)
    sessionLines.clear()
    sessionLabels.clear()

    drawLvl(pdhL, pdhT, tgPDH.tag, pdh_txt, pdh_col, pdh_w, d_sty, pdh_sz, pdh_pos, pdh_on)
    drawLvl(pdlL, pdlT, tgPDL.tag, pdl_txt, pdl_col, pdl_w, d_sty, pdl_sz, pdl_pos, pdl_on)
    drawLvl(pwhL, pwhT, tgPWH.tag, pwh_txt, pwh_col, pwh_w, w_sty, pwh_sz, pwh_pos, pwh_on)
    drawLvl(pwlL, pwlT, tgPWL.tag, pwl_txt, pwl_col, pwl_w, w_sty, pwl_sz, pwl_pos, pwl_on)
    drawLvl(pmhL, pmhT, tgPMH.tag, pmh_txt, pmh_col, pmh_w, m_sty, pmh_sz, pmh_pos, pmh_on)
    drawLvl(pmlL, pmlT, tgPML.tag, pml_txt, pml_col, pml_w, m_sty, pml_sz, pml_pos, pml_on)
    drawLvl(open0000NY, bar0000NY, int(na), mid_txt, mid_col, mid_w, o_sty, mid_sz, mid_pos, mid_on)
    drawLvl(wOpen,      barWStart, int(na), wo_txt,  wo_col,  wo_w,  o_sty, wo_sz, wo_pos, wo_on)
    drawLvl(openNYPRE,  barNYPRE,  int(na), pre_txt, pre_col, pre_w, o_sty, pre_sz, pre_pos, pre_on)
    drawLvl(openNYAM,   barNYAM,   int(na), am_txt,  am_col,  am_w,  o_sty, am_sz, am_pos, am_on)
    drawLvl(athPrice,   athStart,  int(na), ath_txt, ath_col, ath_w, ath_sty, ath_sz, ath_pos, ath_on)
