// For every pair of consecutive candles in a block (older = j+1, newer = j) the chart symbol and the
// comparison symbol are compared. Divergence = exactly one of them takes out the older candle's extreme.
smtHtfDraw(array<HtfCandle> cs, CorrSeries s1, CorrSeries s2) =>
    int n = cs.size()
    if n > 1
        for j = 0 to n - 2
            HtfCandle nw = cs.get(j)
            HtfCandle od = cs.get(j + 1)
            if not na(nw.midX) and not na(od.midX)
                for p = 0 to 1
                    bool       pOn = p == 0 ? smtHtfPair1On : smtHtfPair2On
                    bool       inv = p == 0 ? smt_pair1_inverse : smt_pair2_inverse
                    CorrSeries cr  = p == 0 ? s1 : s2
                    string     tag = p == 0 ? smt_label_pair1 : smt_label_pair2
                    if pOn and cr.hi.size() > j + 1 and cr.lo.size() > j + 1
                        float nH = cr.hi.get(j)
                        float oH = cr.hi.get(j + 1)
                        float nL = cr.lo.get(j)
                        float oL = cr.lo.get(j + 1)
                        if not (na(nH) or na(oH) or na(nL) or na(oL))
                            bool bearSmt = (nw.h > od.h) != (inv ? (nL < oL) : (nH > oH))
                            bool bullSmt = (nw.l < od.l) != (inv ? (nH > oH) : (nL < oL))
                            bool forming = j == 0
                            if bearSmt
                                smtHtfLine(od.midX, od.h, nw.midX, nw.h, true, forming, tag)
                            if bullSmt
                                smtHtfLine(od.midX, od.l, nw.midX, nw.l, false, forming, tag)

