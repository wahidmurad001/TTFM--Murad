//#region [MODEL CALCULATION PREPARATION]
autoTf = switch modelType
    '1m-15m' => '15'
    '2m-20m' => '20'
    '3m-30m' => '30'
    '5m-1H'  => '60'
    '15m-4H' => '240'
    '30m-6H' => '360'
    '1H-1D'  => '1D'
    '4H-1W'  => '1W'
    '1D-1W'  => '1W'
    'Custom' => customHTF
    =>          autoHTF()

var bool validTf = modelType == 'Auto' ? isAutoValidTf(tfMins(curTfCode())) : tfMins(curTfCode()) <= tfMins(ltfCode())
tAuto         = time(autoTf)
periodChanged = tAuto != tAuto[1]

// [FAST] Calc window: heavy work (setups, IC-CISD, Early C2, BSL/SSL, SMT, CISD levels) only runs on bars inside the
// last `calcCandles` HTF candles (never less than smt_lookback + 100 chart bars, so the SMT engine keeps its lookback).
var int windowMs = math.max(tfMins(autoTf) * 60000 * calcCandles, timeframe.in_seconds() * 1000 * (smt_lookback + 100))
bool recent = time >= last_bar_time - windowMs

// [CFD] Pair registry. USTEC <-> US500 are returned bare and get the broker prefix added below.
f_smt_pair_registry(string t) =>
    string p = ""
    if str.contains(t, "USTEC") or str.contains(t, "NAS100") or str.contains(t, "US100")
        p := "US500"
    else if str.contains(t, "US500") or str.contains(t, "SPX500")
        p := "USTEC"
    else
        keys = array.from("MES", "MNQ", "MYM", "M2K", "ES", "NQ", "YM", "RTY", "BTC", "ETH", "MGC", "SIL", "GC", "SI", "EURUSD", "GBPUSD", "GOLD")
        vals = array.from("MNQ1!", "MES1!", "MES1!", "MES1!", "NQ1!", "ES1!", "ES1!", "ES1!", "ETH1!", "BTC1!", "SIL1!", "MGC1!", "SI1!", "GC1!", "GBPUSD", "EURUSD", "SI1!")
        for i = 0 to keys.size() - 1
            if str.contains(t, keys.get(i))
                p := vals.get(i)
                break
    p

// The pair never changes during a run: resolve it once instead of on every bar
var string smt_pairRaw = smt_useManualPair ? smt_manualPair : f_smt_pair_registry(str.upper(syminfo.ticker))
var bool   smt_isCfd   = smt_pairRaw == "US500" or smt_pairRaw == "USTEC"
var string smt_pair1   = smt_useManualPair ? smt_manualPair : (smt_isCfd ? syminfo.prefix + ":" + smt_pairRaw : smt_pairRaw)
var string smt_pair2   = smt_useSecondPair ? smt_secondPair : ""
var string pspSym      = pspAuto and smt_pair1 != "" ? smt_pair1 : pspSymbol

// [PAIR] chart-timeframe bars of the SMT pair 1 (shared by: HTF blocks, SMT engine, SMT-on-HTF add-on, PSP, C2 SMT)
[pairO, pairH, pairL, pairC] = request.security(smt_pair1 != "" ? smt_pair1 : syminfo.tickerid, timeframe.period, [open, high, low, close], ignore_invalid_symbol = true)
// [PAIR] second comparison symbol: falls back to the chart symbol (no extra data) while the second pair is off
[pair2H, pair2L] = request.security(smt_pair2 != "" ? smt_pair2 : syminfo.tickerid, timeframe.period, [high, low], ignore_invalid_symbol = true)
// [PSP] PSP symbol. With PSP auto the PSP symbol IS SMT pair 1, so the pair call above is reused (no extra request).
var bool pspSame = pspSym == smt_pair1
[pspLtfO, pspLtfC] = request.security(showPsp and not pspSame ? pspSym : syminfo.tickerid, timeframe.period, [open, close], ignore_invalid_symbol = true)
float pspQoSrc = pspSame ? pairO : pspLtfO
float pspQcSrc = pspSame ? pairC : pspLtfC

// NOTE: c2Buy / c2Sell are now computed in [LOGIC] from the drawn HTF candle (h0 / l0 / h1 / l1),
// so a C2 tag can never appear on a candle that did not visibly sweep C1.

// name = 'C3' / 'C4' / 'C5' / 'C6'
drawPhase(bool isBull, string name) =>
    mid   = (state.prevHigh + state.prevLow) / 2
    top   = math.max(open, mid)
    bot   = math.min(open, mid)
    yDash = isBull ? bot : top
    box   bx   = showTSpot ? box.new(bar_index, top, bar_index, bot, border_color = na, bgcolor = isBull ? tSpotBullColor : tSpotBearColor, force_overlay = true) : na
    line  dash = showEQ ? line.new(bar_index, yDash, bar_index, yDash, color = eqColor, width = eqWidth, style = lineStyleFromStr(eqStyle), force_overlay = true) : na
    label lbl  = (showTSpot and showLabels and validTf) ? directionalLabel(bar_index + 2, isBull ? bot : top, name, isBull) : na
    [bx, dash, lbl, top, bot]

newSetup(bool isBull, float extreme, label c2Lbl, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, int c2BarIndex, string c2Tag) =>
    s = C2Setup.new(isBull, extreme, 1, false, c2Lbl)
    s.c2BarIndex := c2BarIndex
    s.oldBoxes   := array.new<box>()
    s.oldDashes  := array.new<line>()
    s.oldLbls    := array.new<label>()
    [bx, dash, lbl, _, _] = drawPhase(isBull, 'C3')
    s.c3Box     := bx
    s.c3Dash    := dash
    s.c3Lbl     := lbl
    s.cisdLevel := cisdLevel
    s.cisdIndex := cisdIndex
    if cisdAlreadyConfirmed and not na(cisdLevel) and not na(cisdIndex) and not na(cisdConfirmBar)
        confirmCisd(s, cisdConfirmBar)
        s.replayIc(bar_index - 1)
    // [TAGS] at this moment: get(2) = C1, get(1) = C2 candle, get(0) = the new forming candle (C3)
    if htfCandles.size() > 2
        s.c1Candle := htfCandles.get(2)
    if htfCandles.size() > 1
        s.c2Candle := htfCandles.get(1)
    if htfCandles.size() > 0
        s.c3Candle := htfCandles.get(0)
    setRole(s.c1Candle, isBull, 'C1', c123Color)
    setRole(s.c2Candle, isBull, c2Tag, c123Color)
    setRole(s.c3Candle, isBull, 'C3', c123Color)
    registerRecord(s)
    s

method advanceToC4(C2Setup s) =>
    if htfCandles.size() > 1
        c3 = htfCandles.get(1)
        s.c3Extreme := s.isBull ? c3.l : c3.h
    if not na(s.c3Box)
        box.set_right(s.c3Box, bar_index)
    if not na(s.c3Dash)
        line.set_x2(s.c3Dash, bar_index)
    [bx, dash, lbl, top, bot] = drawPhase(s.isBull, 'C4')
    s.c4Box     := bx
    s.c4Dash    := dash
    s.c4Lbl     := lbl
    s.c4Top     := top
    s.c4Bottom  := bot
    s.phase     := 2
    s.stage     := 4
    s.c4Invalid := false
    // the newly opened HTF candle is C4
    if htfCandles.size() > 0
        s.c4Candle := htfCandles.get(0)
    setRole(s.c4Candle, s.isBull, 'C4', c123Color)
    s

// C4 -> C5 -> C6. Freezes the current stage box / dash / label and draws the next stage.
// Phase stays 2, so IC-CISD detection carries on with no other change.
method advanceNext(C2Setup s) =>
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
        s.oldBoxes.push(s.c4Box)
    if not na(s.c4Dash)
        line.set_x2(s.c4Dash, bar_index)
        s.oldDashes.push(s.c4Dash)
    if not na(s.c4Lbl)
        s.oldLbls.push(s.c4Lbl)
    s.stage += 1
    [bx, dash, lbl, top, bot] = drawPhase(s.isBull, 'C' + str.tostring(s.stage))
    s.c4Box     := bx
    s.c4Dash    := dash
    s.c4Lbl     := lbl
    s.c4Top     := top
    s.c4Bottom  := bot
    s.c4Invalid := false
    // the newly opened HTF candle is C5 / C6
    if htfCandles.size() > 0
        if s.stage == 5
            s.c5Candle := htfCandles.get(0)
        else
            s.c6Candle := htfCandles.get(0)
    setRole(stageCandle(s), s.isBull, 'C' + str.tostring(s.stage), c123Color)
    s

method finish(C2Setup s) =>
    if not na(s.c4Box)
        box.set_right(s.c4Box, bar_index)
    if not na(s.c4Dash)
        line.set_x2(s.c4Dash, bar_index)
    s.phase := 0
    s

method extendAndCheck(C2Setup s) =>
    if not na(s) and not s.dead and s.phase != 0
        box  extBox  = s.phase == 1 ? s.c3Box : s.c4Box
        line extDash = s.phase == 1 ? s.c3Dash : s.c4Dash
        if not na(extBox)
            box.set_right(extBox, bar_index)
        if not na(extDash)
            line.set_x2(extDash, bar_index)
        if s.isBull ? low < s.extreme : high > s.extreme
            color xcClr = s.phase == 2 ? color.orange : color.red
            if not na(s.c2Lbl)
                label.set_text(s.c2Lbl, 'XC2')
                label.set_textcolor(s.c2Lbl, xcClr)
            // mirror on the HTF candles: C2 -> XC2, other tags removed
            setRole(s.c2Candle, s.isBull, 'XC2', xcClr)
            clearRole(s.c1Candle, s.isBull, 'C1')
            clearRole(s.c3Candle, s.isBull, 'C3')
            clearRole(s.c4Candle, s.isBull, 'C4')
            clearRole(s.c5Candle, s.isBull, 'C5')
            clearRole(s.c6Candle, s.isBull, 'C6')
            s.wipe()
            s.dead  := true
            s.phase := 0
    s

// A close through the CURRENT stage box (C4 / C5 / C6) invalidates that stage: XC4 / XC5 / XC6.
// close[1] = the previous bar's close. It is run twice per HTF candle (see LOGIC):
//   - on the first bar of a new HTF candle BEFORE advancing, so the last bar close of the old stage candle is checked against the old box
//   - on every other bar, after the box exists
method checkStageInvalid(C2Setup s) =>
    if not na(s) and not s.dead and s.phase == 2 and not s.c4Invalid
        bool invalid = s.isBull ? close[1] < s.c4Bottom : close[1] > s.c4Top
        if invalid
            s.c4Invalid := true
            if not na(s.c4Lbl)
                label.set_text(s.c4Lbl, 'XC' + str.tostring(s.stage))
                label.set_textcolor(s.c4Lbl, color.red)
            setRole(stageCandle(s), s.isBull, 'XC' + str.tostring(s.stage), color.red)
            if not na(s.c4Dash)
                line.set_color(s.c4Dash, color.red)
            if not na(s.c4Box)
                box.delete(s.c4Box)
                s.c4Box := na
    s

method checkCisdConfirm(C2Setup s) =>
    if not na(s) and not s.dead and not s.cisdConfirmed and s.phase != 0 and not na(s.cisdLevel) and not na(s.cisdIndex)
        if s.isBull ? close > s.cisdLevel : close < s.cisdLevel
            confirmCisd(s, bar_index)
    s

processC2(bool trigger, bool allow, bool isBull, float extremePrice, int extremeBar, float sweepFromPrice, int sweepFromBar, float cisdLevel, int cisdIndex, bool cisdAlreadyConfirmed, int cisdConfirmBar, C2Setup existing, string c2Tag) =>
    C2Setup result = existing
    if trigger and allow
        label lbl = (validTf and showLabels) ? directionalLabel(extremeBar, extremePrice, c2Tag, isBull) : na
        drawSweepLine(sweepFromBar, sweepFromPrice, bar_index)
        result := newSetup(isBull, extremePrice, lbl, cisdLevel, cisdIndex, cisdAlreadyConfirmed, cisdConfirmBar, extremeBar, c2Tag)
    else if periodChanged and not na(existing) and not existing.dead
        // C3 -> C4. From C4 on: advance to the next candle (up to maxCandle) unless the current stage was
        // invalidated (XC4 / XC5 / XC6); then the setup finishes and no further box prints.
        result := existing.phase == 1 ? existing.advanceToC4() : existing.phase == 2 ? ((not existing.c4Invalid and existing.stage < maxCandle) ? existing.advanceNext() : existing.finish()) : existing
    result

markTrigger(bool trigger, bool allow, int idx, bool isBuy) =>
    if trigger and allow and htfCandles.size() > idx
        c = htfCandles.get(idx)
        if isBuy
            c.triggerBuy := true
        else
            c.triggerSell := true

// ---- [TAGS] derived C1..C6 tags for the HTF 2 / HTF 3 blocks ----
// index 0 = newest / forming candle, higher index = older. No boxes or IC logic on these blocks.
// Box invalidation is approximated with the candle's own close vs (its open, previous candle equilibrium).
tagSetupExtra(array<HtfCandle> cs, int i, bool isBull) =>
    HtfCandle c2 = cs.get(i)
    HtfCandle c1 = cs.get(i + 1)
    float ext = isBull ? c2.l : c2.h
    int breachIdx = -1
    // earliest candle after C2 that trades beyond the C2 extreme
    for k = i - 1 to 0
        bool br = isBull ? cs.get(k).l < ext : cs.get(k).h > ext
        if br
            breachIdx := k
            break
    if breachIdx >= 0
        setRole(c2, isBull, 'XC2', breachIdx <= i - 2 ? color.orange : color.red)
    else
        // [PAIR] C2 + PSP: C2 closed a different color than the same HTF candle on the PSP symbol
        bool pspX = showPsp and not na(c2.qO) and not na(c2.qC) and (c2.c - c2.o) * (c2.qC - c2.qO) < 0
        // [PAIR] C2 + SMT: the pair did NOT sweep its own C1 (same rule as HTF 1)
        bool smtX = false
        if showC2Smt and smt_pair1 != "" and not na(c2.pH) and not na(c1.pH) and not na(c2.pL) and not na(c1.pL)
            smtX := isBull ? (smt_pair1_inverse ? c2.pH <= c1.pH : c2.pL >= c1.pL) : (smt_pair1_inverse ? c2.pL >= c1.pL : c2.pH <= c1.pH)
        setRole(c1, isBull, 'C1', c123Color)
        setRole(c2, isBull, c2TagText(pspX, smtX), c123Color)
        setRole(cs.get(i - 1), isBull, 'C3', c123Color)
        for stg = 4 to maxCandle
            int idx = i - (stg - 2)
            if idx < 0
                break
            HtfCandle sc = cs.get(idx)
            HtfCandle pv = cs.get(idx + 1)
            float eqP = (pv.h + pv.l) / 2
            bool inv = isBull ? sc.c < math.min(sc.o, eqP) : sc.c > math.max(sc.o, eqP)
            setRole(sc, isBull, (inv ? 'XC' : 'C') + str.tostring(stg), inv ? color.red : c123Color)
            if inv
                break
    true

tagExtraBlock(array<HtfCandle> cs, int k) =>
    int n = cs.size()
    bool tags = c123Show and c123Ons.get(k) and showLabels
    if tags
        for j = 0 to n - 1
            HtfCandle c = cs.get(j)
            c.buyRole  := na
            c.sellRole := na
    if tags and n >= 3
        // honour the History setting: only the most recent setups are tagged
        int lastI = n - 2
        int found = 0
        for i = 1 to n - 2
            HtfCandle h2 = cs.get(i)
            HtfCandle h1 = cs.get(i + 1)
            bool b1 = allowBuy  and h2.l < h1.l and h2.c > h1.l
            bool s1 = allowSell and h2.h > h1.h and h2.c < h1.h
            found += (b1 ? 1 : 0) + (s1 ? 1 : 0)
            if showHistory > 0 and found >= showHistory
                lastI := i
                break
        // oldest first, so a newer setup's tag wins on a shared candle
        for i = lastI to 1
            HtfCandle g2 = cs.get(i)
            HtfCandle g1 = cs.get(i + 1)
            if allowBuy and g2.l < g1.l and g2.c > g1.l
                tagSetupExtra(cs, i, true)
            if allowSell and g2.h > g1.h and g2.c < g1.h
                tagSetupExtra(cs, i, false)

extraSweepClear() =>
    while extraSweepLines.size() > 0
        line.delete(extraSweepLines.pop())

// Candle 1 sweep lines for HTF 2 / HTF 3 previews
extraSweepDraw(array<HtfCandle> cs) =>
    if showSweep and cs.size() > 2
        for i = 2 to cs.size() - 1
            HtfCandle c1 = cs.get(i)
            HtfCandle c2 = cs.get(i - 1)
            bool buyS  = allowBuy  and c2.l < c1.l and c2.c > c1.l
            bool sellS = allowSell and c2.h > c1.h and c2.c < c1.h
            if (buyS or sellS) and not na(c1.midX) and not na(c2.midX)
                float price = buyS ? c1.l : c1.h
                extraSweepLines.push(line.new(c1.midX, price, c2.midX + 4, price, xloc = xloc.bar_index, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth, force_overlay = true))
//#endregion

//#region [LOGIC]
var float h0 = high
var float l0 = low
var float h1 = high
var float l1 = low

if periodChanged
    h1 := h0[1]
    l1 := l0[1]
    h0 := high
    l0 := low
if high >= h0
    h0 := high
if low <= l0
    l0 := low

// C2 = the drawn HTF candle swept C1's extreme and closed back inside (same bars as the drawn candles)
c2Buy  = l0 < l1 and close > l1
c2Sell = h0 > h1 and close < h1

bool up = close > open
bool dw = close < open
bool eq = close == open
int  ctype = up ? 1 : dw ? -1 : 0   // [MERGE] shared candle type: 1 bull / -1 bear / 0 doji

var float bullLevelFixed = na
var int   bullIndexFixed = na
var float bearLevelFixed = na
var int   bearIndexFixed = na

// [FAST] CISD level search only matters for setups, which only exist inside the calc window
if recent and low == l0 and low < l1
    if (dw[0] or eq[0]) and (up[1] or eq[1]) and not (eq[0] and eq[1])
        bullLevelFixed := open
        bullIndexFixed := bar_index
    else
        for i = 2 to 10
            if low[i] < low
                break
            if (up[i] or eq[i]) and dw[i - 1]
                b = i - 1
                bullLevelFixed := open[b]
                bullIndexFixed := bar_index - b
                for j = b to 0
                    if open[j] > bullLevelFixed and dw[j]
                        bullLevelFixed := open[j]
                        bullIndexFixed := bar_index - j
                if bullLevelFixed < open
                    bullLevelFixed := close > open ? high : open
                    bullIndexFixed := bar_index
                break

if recent and high == h0 and high > h1
    if (up[0] or eq[0]) and (dw[1] or eq[1]) and not (eq[0] and eq[1])
        bearLevelFixed := open
        bearIndexFixed := bar_index
    else
        for i = 2 to 10
            if high[i] > high
                break
            if (dw[i] or eq[i]) and up[i - 1]
                yb = i - 1
                bearLevelFixed := open[yb]
                bearIndexFixed := bar_index - yb
                for j = yb to 0
                    if open[j] < bearLevelFixed and up[j]
                        bearLevelFixed := open[j]
                        bearIndexFixed := bar_index - j
                if bearLevelFixed > open
                    bearLevelFixed := close < open ? low : open
                    bearIndexFixed := bar_index
                break

var bool bullReclaimed  = false
var int  bullReclaimBar = na
var bool bearReclaimed  = false
var int  bearReclaimBar = na

if not na(bullIndexFixed) and (na(bullIndexFixed[1]) or bullIndexFixed != bullIndexFixed[1])
    bullReclaimed  := false
    bullReclaimBar := na
if not na(bullLevelFixed) and not bullReclaimed and close > bullLevelFixed
    bullReclaimed  := true
    bullReclaimBar := bar_index

if not na(bearIndexFixed) and (na(bearIndexFixed[1]) or bearIndexFixed != bearIndexFixed[1])
    bearReclaimed  := false
    bearReclaimBar := na
if not na(bearLevelFixed) and not bearReclaimed and close < bearLevelFixed
    bearReclaimed  := true
    bearReclaimBar := bar_index

candleOffset = candleOffsetIn + 10

if periodChanged
    if htfCandles.size() > 0
        newest             = htfCandles.first()
        state.prevHigh    := newest.h
        state.prevLow     := newest.l
        state.prevHighBar := newest.hBar
        state.prevLowBar  := newest.lBar
    if htfCandles.size() > 1
        prior                  = htfCandles.get(1)
        state.prevPrevHigh    := prior.h
        state.prevPrevLow     := prior.l
        state.prevPrevHighBar := prior.hBar
        state.prevPrevLowBar  := prior.lBar
    htfCandles.unshift(newHtfCandle())
    while htfCandles.size() > htf1Count
        htfCandles.pop().delete()
else if htfCandles.size() > 0
    htfCandles.first().update(high, low, close, bar_index)

// new-candle events for HTF 2 / HTF 3 (also reused by the SMT-on-HTF add-on)
int  tHtf2 = time(na(htf2Tf) ? timeframe.period : htf2Tf)
int  tHtf3 = time(na(htf3Tf) ? timeframe.period : htf3Tf)
bool ch2   = showHtf2 and not na(htf2Tf) and tHtf2 != tHtf2[1]
bool ch3   = showHtf3 and not na(htf3Tf) and tHtf3 != tHtf3[1]

if showHtf2
    htf2Candles.manageExtraHTF(htf2Tf, htf2Count, ch2, pairO, pairH, pairL, pairC, pspQoSrc, pspQcSrc)
if showHtf3
    htf3Candles.manageExtraHTF(htf3Tf, htf3Count, ch3, pairO, pairH, pairL, pairC, pspQoSrc, pspQcSrc)

if periodChanged
    state.prevC2Buy  := c2Buy[1]
    state.prevC2Sell := c2Sell[1]

c2BuyTrigger  = periodChanged and state.prevC2Buy
c2SellTrigger = periodChanged and state.prevC2Sell

// [PSP / SMT-C2] Per-HTF-candle accumulators built from chart-timeframe bars. They replace the old HTF request.security
// calls (own open/close, correlated open/close, pair high/low) so no extra data request is needed.
var float ownO0 = na   // forming HTF candle open / close (chart symbol)
var float ownC0 = na
var float qO0   = na   // forming HTF candle open / close (PSP symbol)
var float qC0   = na
var float sH0   = na   // forming HTF candle high / low (SMT pair 1)
var float sL0   = na
var float sH1   = na   // last completed candle (C2 on the first bar of a new HTF candle)
var float sL1   = na
var float sH2   = na   // the candle before it (C1)
var float sL2   = na
// values of the candle that just closed (valid on the first bar of a new HTF candle, which is the only bar they are read)
float pspOwnO  = ownO0
float pspOwnC  = ownC0
float pspCorrO = qO0
float pspCorrC = qC0
if periodChanged
    sH2   := sH1
    sL2   := sL1
    sH1   := sH0
    sL1   := sL0
    ownO0 := open
    qO0   := pspQoSrc
    sH0   := pairH
    sL0   := pairL
else
    sH0 := na(sH0) ? pairH : (na(pairH) ? sH0 : math.max(sH0, pairH))
    sL0 := na(sL0) ? pairL : (na(pairL) ? sL0 : math.min(sL0, pairL))
ownC0 := close
qC0   := pspQcSrc

bool pspHit = showPsp and not na(pspOwnO) and not na(pspCorrO) and (pspOwnC - pspOwnO) * (pspCorrC - pspCorrO) < 0
// [SMT-C2] pair's C2 / C1 range on the same HTF
bool smtReady   = showC2Smt and smt_pair1 != "" and not na(sL2) and not na(sH2) and not na(sL1) and not na(sH1)
// chart swept C1 (that is what makes it a C2); SMT = the pair did NOT sweep its own C1 (inverse pairs: opposite side)
bool smtBuyHit  = smtReady and (smt_pair1_inverse ? sH1 <= sH2 : sL1 >= sL2)
bool smtSellHit = smtReady and (smt_pair1_inverse ? sL1 >= sL2 : sH1 <= sH2)

// First bar of a new HTF candle: close[1] is the LAST bar of the stage candle that just ended.
// Check it against the OLD stage box before the setup advances (or finishes).
if periodChanged
    buySetup  := buySetup.checkStageInvalid()
    sellSetup := sellSetup.checkStageInvalid()

// [FAST] new setups are only created inside the calc window (allow ... and recent)
buySetup  := processC2(c2BuyTrigger, allowBuy and recent, true, state.prevLow, state.prevLowBar, state.prevPrevLow, state.prevPrevLowBar, bullLevelFixed[1], bullIndexFixed[1], bullReclaimed[1], bullReclaimBar[1], buySetup, c2TagText(pspHit, smtBuyHit))
sellSetup := processC2(c2SellTrigger, allowSell and recent, false, state.prevHigh, state.prevHighBar, state.prevPrevHigh, state.prevPrevHighBar, bearLevelFixed[1], bearIndexFixed[1], bearReclaimed[1], bearReclaimBar[1], sellSetup, c2TagText(pspHit, smtSellHit))

markTrigger(c2BuyTrigger, allowBuy, 2, true)
markTrigger(c2SellTrigger, allowSell, 2, false)

buySetup  := buySetup.extendAndCheck()
sellSetup := sellSetup.extendAndCheck()

// every other bar: close[1] belongs to the current stage candle, and the box already exists
if not periodChanged
    buySetup  := buySetup.checkStageInvalid()
    sellSetup := sellSetup.checkStageInvalid()

buySetup  := buySetup.checkCisdConfirm()
sellSetup := sellSetup.checkCisdConfirm()

// check every persistent dot against the current bar BEFORE new dots can form on it
icMarkTakenAll()

buySetup  := buySetup.updateIc()
sellSetup := sellSetup.updateIc()

//#region [EARLY C2 DETECTION]
// While the current HTF candle (the would-be C2) is still forming, flag it as a prospective C2
// when its wick has swept C1's extreme AND its body is back inside C1's range.
bool earlyBuyOn  = false
bool earlySellOn = false
HtfCandle earlyDev = htfCandles.size() > 0 ? htfCandles.first() : na

if showEarlyC2 and validTf and recent and not na(earlyDev)
    float earlyBodyHi = math.max(earlyDev.o, earlyDev.c)
    float earlyBodyLo = math.min(earlyDev.o, earlyDev.c)
    earlyBuyOn  := allowBuy  and not na(state.prevLow)  and not na(state.prevLowBar)  and earlyDev.l < state.prevLow  and earlyBodyLo > state.prevLow
    earlySellOn := allowSell and not na(state.prevHigh) and not na(state.prevHighBar) and earlyDev.h > state.prevHigh and earlyBodyHi < state.prevHigh

// k = 0 bullish (sweeps C1 low), k = 1 bearish (sweeps C1 high)
earlyC2(int k, bool on) =>
    bool buy = k == 0
    line  l  = eLn.get(k)
    label b  = eLb.get(k)
    if periodChanged or not on
        line.delete(l)
        label.delete(b)
        l := na
        b := na
    if on
        float p  = buy ? state.prevLow : state.prevHigh
        int   pb = buy ? state.prevLowBar : state.prevHighBar
        if na(l)
            l := line.new(pb, p, bar_index, p, xloc.bar_index, extend.none, earlyC2Color, lineStyleFromStr(earlyC2Style), earlyC2Width, force_overlay = true)
        else
            line.set_xy1(l, pb, p)
            line.set_xy2(l, bar_index, p)
        int   lx = buy ? earlyDev.lBar : earlyDev.hBar
        float ly = buy ? earlyDev.l : earlyDev.h
        if showLabels
            if na(b)
                b := label.new(lx, ly, 'C2?', xloc = xloc.bar_index, yloc = yloc.price, style = buy ? label.style_label_up : label.style_label_down, color = na, textcolor = color.new(c2c3c4Color, 30), size = textSize(labelSize), text_font_family = font.family_default, force_overlay = true)
            else
                label.set_xy(b, lx, ly)
        else
            label.delete(b)
            b := na
    eLn.set(k, l)
    eLb.set(k, b)

earlyC2(0, earlyBuyOn)
earlyC2(1, earlySellOn)
//#endregion

//#region [LIQUIDITY LEVELS]
liqPivotHigh = showLiq ? ta.pivothigh(high, liqSwingLen, liqSwingLen) : na
liqPivotLow  = showLiq ? ta.pivotlow(low, liqSwingLen, liqSwingLen) : na
liqPivotBar  = bar_index - liqSwingLen

addLiq(Liq q, float price, int pBar, string txt) =>
    q.ln.push(line.new(pBar, price, bar_index, price, xloc.bar_index, extend.none, liqColor, lineStyleFromStr(liqStyleStr), liqWidth, force_overlay = true))
    q.lb.push(liqShowLabel ? label.new(bar_index, price, txt, xloc = xloc.bar_index, style = label.style_label_left, color = na, textcolor = liqColor, size = textSize(liqLabelSize), force_overlay = true) : na)
    q.px.push(price)
    q.sw.push(false)
    while q.ln.size() > liqMaxLines
        line.delete(q.ln.shift())
        label.delete(q.lb.shift())
        q.px.shift()
        q.sw.shift()

updateLiq(Liq q, bool isBsl) =>
    if q.ln.size() > 0
        for i = 0 to q.ln.size() - 1
            if not q.sw.get(i)
                bool breached = isBsl ? high >= q.px.get(i) : low <= q.px.get(i)
                if breached
                    q.sw.set(i, true)
                line.set_x2(q.ln.get(i), bar_index)
                lb = q.lb.get(i)
                if not breached and not na(lb)
                    label.set_x(lb, bar_index)

updateLiq(bsl, true)
updateLiq(ssl, false)
// [FAST] only the last few pivots are ever kept, so older history never creates lines
if recent and not na(liqPivotHigh)
    addLiq(bsl, liqPivotHigh, liqPivotBar, 'BSL')
if recent and not na(liqPivotLow)
    addLiq(ssl, liqPivotLow, liqPivotBar, 'SSL')
//#endregion
//#endregion

//#region [PLOT]
// [FAST] UI throttle: heavy live redraws run at most once per second (always on bar close and on history)
var int lastUI = 0
bool uiDue = barstate.ishistory or barstate.isconfirmed or timenow - lastUI >= 1000

// Draws one HTF block (k = 0/1/2): candles, HTF open line, info label, Candle 1 sweeps (k > 0), C1-C6 tags
drawBlock(int k, array<HtfCandle> cs, string tf, int start) =>
    int n = cs.size()
    // HTF 1 tags are written by the setups; the other blocks derive theirs here
    if k > 0
        tagExtraBlock(cs, k)
    for i = n - 1 to 0
        cs.get(i).draw(bar_index + start + candleSpacing * (n - 1 - i), k, tf)
    line ol = openLns.get(k)
    if showOpens.get(k)
        c = cs.first()
        int ox = math.max(c.startBar, bar_index - 4999)
        if na(ol)
            ol := line.new(ox, c.o, ox, c.o, xloc.bar_index, extend.none, openCols.get(k), lineStyleFromStr(openStyles.get(k)), openWidths.get(k), force_overlay = true)
            openLns.set(k, ol)
        line.set_xy1(ol, ox, c.o)
        line.set_xy2(ol, box.get_right(c.body), c.o)
    else if not na(ol)
        line.delete(ol)
        openLns.set(k, na)
    if k > 0
        extraSweepDraw(cs)
    label il = infoLbls.get(k)
    if showTfs.get(k) or showTimers.get(k)
        float gh = cs.get(0).h
        float gl = cs.get(0).l
        if n > 1
            for i = 1 to n - 1
                gh := math.max(gh, cs.get(i).h)
                gl := math.min(gl, cs.get(i).l)
        gh += math.max((gh - gl) * htfLblPad, syminfo.mintick * 12.0)
        int cx = k == 0 ? int(math.round((cs.first().midX + cs.get(n - 1).midX) / 2)) : bar_index + start + int(candleSpacing * (n - 1) / 2)
        string txt = (k > 0 or showTfs.get(k)) ? tfLabel(tf) : ''
        if showTimers.get(k)
            int rem = time_close(tf) - (barstate.isrealtime ? timenow : time_close)
            txt += (txt == '' ? '' : '\n') + '(' + formatRemaining(rem, tfMins(tf) >= 60) + ')'
        if na(il)
            il := label.new(cx, gh, txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = na, textcolor = infoCols.get(k), size = textSize(lblSizes.get(k)), text_font_family = font.family_default, force_overlay = true)
            infoLbls.set(k, il)
        else
            label.set_xy(il, cx, gh)
            label.set_text(il, txt)
    else if not na(il)
        label.delete(il)
        infoLbls.set(k, na)

dropInfo(int k) =>
    label.delete(infoLbls.get(k))
    infoLbls.set(k, na)

// Early C2 (prospective) level line on the HTF 1 preview: from C1's wick tip across the developing candle
earlyPanel(int k, bool on) =>
    line l = ePn.get(k)
    if on
        HtfCandle c1 = htfCandles.get(1)
        HtfCandle c2 = htfCandles.get(0)
        float p = k == 0 ? c1.l : c1.h
        if na(l)
            l := line.new(c1.midX, p, c2.midX + 4, p, xloc.bar_index, extend.none, earlyC2Color, lineStyleFromStr(earlyC2Style), earlyC2Width, force_overlay = true)
        else
            line.set_xy1(l, c1.midX, p)
            line.set_xy2(l, c2.midX + 4, p)
    else
        line.delete(l)
        l := na
    ePn.set(k, l)

if uiDue and (barstate.islast or barstate.isrealtime) and validTf and htfCandles.size() > 0 and showHtf1
    n = htfCandles.size()
    extraSweepClear()
    drawBlock(0, htfCandles, autoTf, candleOffset)

    for i = n - 1 to 0
        if i > 0
            c     = htfCandles.get(i)
            nextC = htfCandles.get(i - 1)
            line.set_x2(c.eqLine, nextC.midX)
            if showSweep and (c.triggerBuy or c.triggerSell)
                price = c.triggerBuy ? c.l : c.h
                if na(c.sweepLine)
                    c.sweepLine := line.new(c.midX, price, nextC.midX + 4, price, color = sweepColor, style = lineStyleFromStr(sweepStyle), width = sweepWidth, force_overlay = true)
                else
                    line.set_xy1(c.sweepLine, c.midX, price)
                    line.set_xy2(c.sweepLine, nextC.midX + 4, price)

    earlyPanel(0, showEarlyC2 and earlyBuyOn and n >= 2)
    earlyPanel(1, showEarlyC2 and earlySellOn and n >= 2)

    int htf2Start = candleOffset + (htf1Count - 1) * candleSpacing + 2 + 2 * candleSpacing
    bool drew2 = showHtf2 and not na(htf2Tf) and htf2Candles.size() > 0
    if drew2
        drawBlock(1, htf2Candles, htf2Tf, htf2Start)
    else
        dropInfo(1)
    int htf3Start = htf2Start + (htf2Count - 1) * candleSpacing + 2 + 2 * candleSpacing
    bool drew3 = showHtf3 and not na(htf3Tf) and htf3Candles.size() > 0
    if drew3
        drawBlock(2, htf3Candles, htf3Tf, htf3Start)
    else
        dropInfo(2)
else if barstate.islast and uiDue
    extraSweepClear()
    for k = 0 to 2
        dropInfo(k)
        line.delete(openLns.get(k))
        openLns.set(k, na)
    earlyPanel(0, false)
    earlyPanel(1, false)
//#endregion

//#region [HTF VERTICAL SEPARATORS]
// Ported from "Fractal-CISD Model by Odegos". Full-height vertical line at every boundary of the chosen HTF, plus a
// projected line at the close of the forming HTF bar. Drawn with force_overlay = true so it lands on the price chart.
grpSep = 'HTF Separators'
sep_show             = input.bool(true, 'Show Vertical Separators', group = grpSep)
sep_source           = input.string('HTF 1', 'Separator HTF', options = ['HTF 1', 'HTF 2', 'HTF 3'], group = grpSep, tooltip = 'Which HTF block drives the separators. HTF 1 = the model HTF (e.g. 4H on a 15m chart).')
sep_color            = input.color(color.new(#000000, 75), 'Separator Color', group = grpSep)
sep_style_inp        = input.string('Solid', 'Separator Style', options = ['Solid', 'Dashed', 'Dotted', 'Arrow'], group = grpSep)
sep_width            = input.int(1, 'Separator Width', minval = 1, maxval = 4, group = grpSep)
sep_active_style_inp = input.string('Dotted', 'Active HTF Bar Separator', options = ['Solid', 'Dashed', 'Dotted', 'Arrow', 'None'], group = grpSep, tooltip = 'Style of the projected separator at the close of the current (still forming) HTF bar. It is replaced by the normal separator once that bar closes.')
sep_keep             = input.int(6, 'Separators to keep', minval = 1, maxval = 50, group = grpSep, tooltip = 'Past separators kept on the chart. They share the 500 line budget with the rest of the indicator, so keep this modest.')

f_sep_style(string s) =>
    switch s
        'Dashed' => line.style_dashed
        'Dotted' => line.style_dotted
        'Arrow'  => line.style_arrow_right
        => line.style_solid

// Resolve the chosen HTF (falls back to the chart TF when HTF 2 / HTF 3 is not defined, which disables drawing below).
string sep_tf_raw   = sep_source == 'HTF 1' ? autoTf : sep_source == 'HTF 2' ? htf2Tf : htf3Tf
string sep_tf       = na(sep_tf_raw) ? timeframe.period : sep_tf_raw
int    sep_sec      = timeframe.in_seconds(sep_tf)
int    sep_chart_sec = timeframe.in_seconds()
int    sep_time     = time(sep_tf)
int    sep_close_t  = time_close(sep_tf)
bool   sep_new_bar  = ta.change(sep_time) != 0 and not na(sep_time)

// CME Sunday 18:00 ET reopen: time() does not always change cleanly there on daily/weekly HTFs, so add that boundary explicitly.
bool sep_in_1800       = not na(time('1', '1800-1801', 'America/New_York'))
bool sep_sunday_reopen = sep_in_1800 and not sep_in_1800[1] and dayofweek(time, 'America/New_York') == dayofweek.sunday and sep_sec >= 86400 and sep_sec <= 604800

float sep_tr = ta.tr

var array<line> sep_pool   = array.new<line>()
var line        sep_active = na

bool sep_allow  = sep_show and sep_sec > sep_chart_sec
int  sep_window = sep_allow ? int((sep_keep + 1) * sep_sec / sep_chart_sec) : 0

if sep_allow and (sep_new_bar or sep_sunday_reopen) and bar_index >= last_bar_index - sep_window
    // The projected (dotted) separator is replaced by a solid one at the boundary that just arrived.
    if not na(sep_active)
        line.delete(sep_active)
        sep_active := na
    sep_pool.push(line.new(bar_index, low - sep_tr, bar_index, high + sep_tr, xloc.bar_index, extend.both, sep_color, f_sep_style(sep_style_inp), sep_width, force_overlay = true))
    while sep_pool.size() > sep_keep
        line.delete(sep_pool.shift())
    // Projected separator at the true close of the forming HTF bar (session / gap aware).
    if sep_active_style_inp != 'None' and not na(sep_close_t)
        sep_active := line.new(sep_close_t, low - sep_tr, sep_close_t, high + sep_tr, xloc.bar_time, extend.both, sep_color, f_sep_style(sep_active_style_inp), sep_width, force_overlay = true)

// Turning the feature off (or switching to an HTF that is not above the chart TF) removes what is on screen.
if not sep_allow and barstate.islast
    if not na(sep_active)
        line.delete(sep_active)
        sep_active := na
    while sep_pool.size() > 0
        line.delete(sep_pool.shift())
//#endregion


// ============================================================
// SMT DIVERGENCE ENGINE
// ============================================================

f_smt_pair_tag(string sym, bool inv) => str.split(sym, ":").last() + (inv ? " (inv)" : "")

// [FAST] the engine only runs inside the calc window
smt_active  = show_smt and smt_pair1 != "" and recent
// labels are constant for the run: build once
var string smt_label_pair1 = smt_useSecondPair ? f_smt_pair_tag(smt_pair1, smt_pair1_inverse) : "SMT"
var string smt_label_pair2 = f_smt_pair_tag(smt_pair2, smt_pair2_inverse)

// pair 1 / pair 2 chart-timeframe highs and lows come from the shared security calls above (pairH / pairL / pair2H / pair2L)
smt_cPH_raw  = show_smt ? ta.pivothigh(high, smt_swingLen, smt_rightLen) : na
smt_cPL_raw  = show_smt ? ta.pivotlow(low, smt_swingLen, smt_rightLen) : na
smt_p1PH_raw = show_smt ? ta.pivothigh(pairH, smt_swingLen, smt_rightLen) : na
smt_p1PL_raw = show_smt ? ta.pivotlow(pairL, smt_swingLen, smt_rightLen) : na
smt_p2PH_raw = show_smt and smt_useSecondPair ? ta.pivothigh(pair2H, smt_swingLen, smt_rightLen) : na
smt_p2PL_raw = show_smt and smt_useSecondPair ? ta.pivotlow(pair2L, smt_swingLen, smt_rightLen) : na

// Live (intrabar) windows
smt_hiWin   = show_smt and smt_live ? ta.highest(high, smt_swingLen) : na
smt_loWin   = show_smt and smt_live ? ta.lowest(low, smt_swingLen) : na
smt_p1HiWin = show_smt and smt_live ? ta.highest(pairH, smt_pairLagBars + 1) : na
smt_p1LoWin = show_smt and smt_live ? ta.lowest(pairL, smt_pairLagBars + 1) : na
smt_p2HiWin = show_smt and smt_live and smt_useSecondPair ? ta.highest(pair2H, smt_pairLagBars + 1) : na
smt_p2LoWin = show_smt and smt_live and smt_useSecondPair ? ta.lowest(pair2L, smt_pairLagBars + 1) : na

smt_cPH  = smt_active ? smt_cPH_raw : na
smt_cPL  = smt_active ? smt_cPL_raw : na
smt_p1PH = smt_active ? smt_p1PH_raw : na
smt_p1PL = smt_active ? smt_p1PL_raw : na
smt_p2PH = smt_active and smt_useSecondPair ? smt_p2PH_raw : na
smt_p2PL = smt_active and smt_useSecondPair ? smt_p2PL_raw : na
smt_pivotBar = bar_index - smt_rightLen

f_smt_delete(int i) =>
    line.delete(smt_lines.get(i))
    label.delete(smt_labels.get(i))
    smt_lines.remove(i)
    smt_labels.remove(i)
    smt_bars.remove(i)
    smt_prices.remove(i)
    smt_types.remove(i)
    smt_scores.remove(i)

// removes any SMT drawn on the current bar by a previous tick, so the live line is rebuilt fresh every tick
f_smt_clear_live() =>
    if smt_lines.size() > 0
        for i = smt_lines.size() - 1 to 0
            if smt_bars.get(i) == bar_index
                f_smt_delete(i)

f_smt_has_overlap(string t, int x1, float y1, int x2, float y2) =>
    bool  bear    = t == "Bearish"
    array<float> cv = bear ? cP.hv : cP.lv
    array<int>   cb = bear ? cP.hb : cP.lb
    bool  blocked = false
    float buffer  = smt_overlapBufferTicks * syminfo.mintick
    if x2 > x1 and cv.size() > 0
        for j = cv.size() - 1 to 0
            int b = cb.get(j)
            // Pivot bars are stored oldest-to-newest; older entries cannot overlap once x1 is reached.
            if b <= x1
                break
            if b < x2
                float lineAt = y1 + (y2 - y1) * (b - x1) / (x2 - x1)
                if bear ? cv.get(j) >= lineAt - buffer : cv.get(j) <= lineAt + buffer
                    blocked := true
                    break
    blocked

f_smt_add(string t, int x1, float y1, int x2, float y2, float score, string txt) =>
    bool skip = score < smt_minTicks or f_smt_has_overlap(t, x1, y1, x2, y2)
    // same SMT already drawn (e.g. live line later confirmed by its swing): keep the existing one
    if not skip and smt_lines.size() > 0
        for i = smt_lines.size() - 1 to 0
            if smt_types.get(i) == t and smt_bars.get(i) == x2 and smt_prices.get(i) == y2
                skip := true
                break
    if not skip and smt_mergeNearby and smt_lines.size() > 0
        for i = smt_lines.size() - 1 to 0
            if smt_types.get(i) == t and math.abs(x2 - smt_bars.get(i)) <= smt_mergeBars
                if score > smt_scores.get(i)
                    f_smt_delete(i)
                else
                    skip := true
                break
    if not skip
        smt_lines.push(line.new(x1, y1, x2, y2, color = smt_lineColor, width = smt_lineWidth, style = lineStyleFromStr(smt_lineStyle), force_overlay = true))
        smt_labels.push(smt_showLabels ? label.new(int(math.round((x1 + x2) / 2)), (y1 + y2) / 2, txt, style = t == "Bearish" ? label.style_label_down : label.style_label_up, textcolor = smt_labelText, color = smt_labelBg, size = textSize(smt_labelSize), force_overlay = true) : na)
        smt_bars.push(x2)
        smt_prices.push(y2)
        smt_types.push(t)
        smt_scores.push(score)

f_smt_nearest(array<int> bars, array<float> vals, int target, int maxDist) =>
    float val = na
    int bestDist = 100000
    if bars.size() > 0
        for i = bars.size() - 1 to 0
            int pivotBar = bars.get(i)
            int dist = math.abs(pivotBar - target)
            if pivotBar <= target and dist > maxDist
                break
            if dist <= maxDist and dist < bestDist
                bestDist := dist
                val := vals.get(i)
    val

// Divergence detector. bear = bearish (highs) / bullish (lows); live = intrabar mode.
//  confirmed swing (live = false): chart and pair disagree on breaking a prior swing.
//  live (live = true): forming bar breaks a prior chart swing while the pair has NOT broken its matching swing.
f_smt(bool bear, bool live, float cur, int curBar, float hiWin, float loWin, Piv pr, bool inv, string txt) =>
    bool pUp = bear != inv
    array<float> ps = pUp ? pr.hv : pr.lv
    array<int>   pb = pUp ? pr.hb : pr.lb
    array<float> cv = bear ? cP.hv : cP.lv
    array<int>   cb = bear ? cP.hb : cP.lb
    float pNow = live ? (pUp ? hiWin : loWin) : f_smt_nearest(pb, ps, curBar, smt_pairLagBars)
    if cv.size() > 0 and ps.size() > (live ? 0 : 1) and not na(pNow)
        float bestScore = na
        int   bestBar   = na
        float bestPrice = na
        for i = cv.size() - 1 to 0
            int rb = cb.get(i)
            if curBar - rb > smt_lookback
                break
            if curBar > rb
                float rv = cv.get(i)
                float rp = f_smt_nearest(pb, ps, rb, smt_pairLagBars)
                if not na(rp)
                    bool chartBreak = bear ? cur > rv : cur < rv
                    bool pairBreak  = pUp ? pNow > rp : pNow < rp
                    if live ? (chartBreak and not pairBreak) : chartBreak != pairBreak
                        float score = math.max(math.abs(cur - rv) / syminfo.mintick, math.abs(pNow - rp) / syminfo.mintick)
                        if na(bestScore) or score > bestScore
                            bestScore := score
                            bestBar   := rb
                            bestPrice := rv
        if not na(bestScore)
            f_smt_add(bear ? "Bearish" : "Bullish", bestBar, bestPrice, curBar, cur, bestScore, txt)

f_smt_push(array<float> v, array<int> b, float x) =>
    if not na(x)
        v.push(x)
        b.push(smt_pivotBar)

f_smt_prune(array<float> v, array<int> b) =>
    int keepFrom = bar_index - smt_lookback - smt_pairLagBars - smt_swingLen - 5
    while b.size() > 0 and b.get(0) < keepFrom
        b.shift()
        v.shift()

// live SMT of the current bar is rebuilt from scratch every tick
if smt_active and smt_live
    f_smt_clear_live()

f_smt_push(p1.hv, p1.hb, smt_p1PH)
f_smt_push(p1.lv, p1.lb, smt_p1PL)
f_smt_push(p2.hv, p2.hb, smt_p2PH)
f_smt_push(p2.lv, p2.lb, smt_p2PL)

if not na(smt_cPH)
    f_smt(true, false, smt_cPH, smt_pivotBar, na, na, p1, smt_pair1_inverse, smt_label_pair1)
    if smt_useSecondPair
        f_smt(true, false, smt_cPH, smt_pivotBar, na, na, p2, smt_pair2_inverse, smt_label_pair2)
    f_smt_push(cP.hv, cP.hb, smt_cPH)

if not na(smt_cPL)
    f_smt(false, false, smt_cPL, smt_pivotBar, na, na, p1, smt_pair1_inverse, smt_label_pair1)
    if smt_useSecondPair
        f_smt(false, false, smt_cPL, smt_pivotBar, na, na, p2, smt_pair2_inverse, smt_label_pair2)
    f_smt_push(cP.lv, cP.lb, smt_cPL)

// live (intrabar) detection runs after the confirmed-swing detection, every tick
if smt_active and smt_live
    if high >= smt_hiWin
        f_smt(true, true, high, bar_index, smt_p1HiWin, smt_p1LoWin, p1, smt_pair1_inverse, smt_label_pair1)
        if smt_useSecondPair
            f_smt(true, true, high, bar_index, smt_p2HiWin, smt_p2LoWin, p2, smt_pair2_inverse, smt_label_pair2)
    if low <= smt_loWin
        f_smt(false, true, low, bar_index, smt_p1HiWin, smt_p1LoWin, p1, smt_pair1_inverse, smt_label_pair1)
        if smt_useSecondPair
            f_smt(false, true, low, bar_index, smt_p2HiWin, smt_p2LoWin, p2, smt_pair2_inverse, smt_label_pair2)

if smt_active and smt_deleteInvalid and smt_lines.size() > 0
    for i = smt_lines.size() - 1 to 0
        float p = smt_prices.get(i)
        bool inval = smt_types.get(i) == "Bearish" ? (smt_invalOnClose ? close > p : high > p) : (smt_invalOnClose ? close < p : low < p)
        if inval
            f_smt_delete(i)

if smt_active
    for pv in smtPivs
        f_smt_prune(pv.hv, pv.hb)
        f_smt_prune(pv.lv, pv.lb)

