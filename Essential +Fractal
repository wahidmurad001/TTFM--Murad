        bool bull = s.isBull
        color dirC = bull ? colBullDB : colBearDB
        HtfCandle c1 = s.c1Candle, c2 = s.c2Candle, c3 = s.c3Candle

        string rawRole = bull ? c2.buyRole : c2.sellRole
        string role2   = na(rawRole) ? "" : rawRole

        bool cisdOk = s.cisdConfirmed and not na(s.cisdEndIndex) and s.cisdEndIndex < c3.startBar
        bool smtOk  = str.contains(role2, "SMT")
        bool pspOk  = str.contains(role2, "PSP")
        // macro: the C2 sweep extreme happened inside a macro window (New York time)
        int   c2SweepTime = time[bar_index - s.c2BarIndex]
        string kzName = f_killzone(c2SweepTime)
        bool macroOk = f_isMacro(c2SweepTime) or kzName != ""
        float r1 = c1.h - c1.l, r2 = c2.h - c2.l
        bool inOk = r1 > 0 and r2 <= 0.75 * r1 and c2.c <= c1.h and c2.c >= c1.l
        // POI (FVG) check only: the first FVG that forms after the C2 sweep (no box is drawn)
        bool fvgOk = false
        int lo = bar_index - c3.startBar + 1
        int hi = math.min(bar_index - math.max(c2.startBar, s.c2BarIndex) - 2, lo + 300)
        if hi >= lo
            for i = hi to lo
                if bull ? high[i + 2] < low[i] : low[i + 2] > high[i]
                    fvgOk := true
                    break
        bool htfOk = f_htfFvgHit(bull, c2.l, c2.h, c2.openTime, s.c2BarIndex)
        int score = (cisdOk ? wCisd : 0) + (smtOk ? wSmt : 0) + (pspOk ? wPsp : 0) + (macroOk ? wMacro : 0) + (fvgOk ? wFvg : 0) + (inOk ? wIn : 0) + (htfOk ? wHtf : 0)
        int pct = int(math.round(score * 100.0 / wTotal))
        string grade = pct >= 70 ? "HIGH" : pct >= 40 ? "MED" : "LOW"

        // row 1: bias + live (merged) | current candle
        f_dbCell(0, 1, (bull ? "▲ BULLISH" : "▼ BEARISH") + " · LIVE", dirC, colTextActiveDB, text.align_center)
        f_dbCell(2, 1, "C" + str.tostring(s.stage), colBullDB, colTextActiveDB, text.align_center)

        // rows 2-8: checklist
        f_dbCheck(2, cisdOk,  "CISD in C2",   wCisd)
        f_dbCheck(3, smtOk,   "SMT on C2",    wSmt)
        f_dbCheck(4, pspOk,   "PSP on C2",    wPsp)
        f_dbCheck(5, macroOk, kzName != "" ? kzName + " KZ" : "Macro/KZ", wMacro)
        f_dbCheck(6, fvgOk,   "POI (FVG)",    wFvg)
        f_dbCheck(7, inOk,    "C2 in 75% C1", wIn)
        f_dbCheck(8, htfOk,   "HTF FVG " + tfLabel(selectedHTF), wHtf)

        // row 9: entry state + grade %
        bool entryOk = s.cisdConfirmed and not s.c4Invalid
        string entryCore = entryOk ? (bull ? "▲ BUY" : "▼ SELL") : s.c4Invalid ? "INVALID" : "WAIT CISD"
        f_dbCell(0, 9, entryCore + " · " + grade + " " + str.tostring(pct) + "%", entryOk ? dirC : colTextInactiveDB, colTextActiveDB, text.align_center, dbProbSize)





