// [PAIR] folds the pair's chart-timeframe bar into the forming HTF candle (open on the first bar, running high / low, latest close)
foldPair(HtfCandle c, bool fresh, float xo, float xh, float xl, float xc, float qo, float qc) =>
    if fresh
        c.pO := xo
        c.qO := qo
    if not na(xh)
        c.pH := na(c.pH) ? xh : math.max(c.pH, xh)
    if not na(xl)
        c.pL := na(c.pL) ? xl : math.min(c.pL, xl)
    c.pC := xc
    c.qC := qc
    true

method manageExtraHTF(array<HtfCandle> cs, string tf, int maxCount, bool changed, float xo, float xh, float xl, float xc, float qo, float qc) =>
    if not na(tf)
        if changed
            HtfCandle nc = newHtfCandle()
            foldPair(nc, true, xo, xh, xl, xc, qo, qc)
            cs.unshift(nc)
            while cs.size() > maxCount
                cs.pop().delete()
        else if cs.size() > 0
            cs.first().update(high, low, close, bar_index)
            foldPair(cs.first(), false, xo, xh, xl, xc, qo, qc)
    cs

parseFloats(string src) =>
    out = array.new<float>()
    for part in str.split(str.replace_all(src, ' ', ''), ',')
        v = str.tonumber(part)
        if not na(v)
            out.push(v)
    out

