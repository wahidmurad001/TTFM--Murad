getCurrentLegExtreme(int bias) =>
    float extreme = open
    int shift = 0
    int ct0 = ctype
    int maxI = math.min(bar_index, 60)
    if ct0 == bias and maxI >= 1
        for i = 1 to maxI
            int ct = ctype[i]
            if ct == 0
                continue
            if ct != bias
                break
            bool better = bias == 1 ? open[i] < extreme : open[i] > extreme
            if better
                extreme := open[i]
                shift := i
    [extreme, bar_index - shift]

getPreviousLegExtreme(int bias) =>
    float extreme = na
    int shift = 0
    bool found = false
    int maxI = math.min(bar_index, 60)
    if maxI >= 1
        for i = 1 to maxI
            int ct = ctype[i]
            if ct == 0
                continue
            bool same = ct == bias
            if not found
                if same
                    found := true
                    extreme := open[i]
                    shift := i
            else
                if not same
                    break
                bool better = bias == 1 ? open[i] < extreme : open[i] > extreme
                if better
                    extreme := open[i]
                    shift := i
    if not found
        extreme := open
        shift := 0
    [extreme, bar_index - shift]

