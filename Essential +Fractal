    var lim = array.from(15, 60, 180, 300, 600, 900, 1800, 2700, 3600, 7200, 14400, 21600, 43200, 86400, 259200, 604800)
    var res = array.from("5", "15", "30", "60", "150", "240", "1D", "720", "1D", "2D", "1W", "4D", "1W", "15D", "45D", "15W")
    string result = "12M"
    for i = 0 to lim.size() - 1
        if tfSeconds <= lim.get(i)
            result := res.get(i)
            break
    result

formatTimeframe(string tf) =>
    seconds = timeframe.in_seconds(tf)
    if seconds < 60
        str.tostring(seconds) + "S"
    else if (seconds / 60) < 60
        str.tostring(math.round(seconds/60)) + "M"
    else if (seconds/60/60) < 24
        str.tostring(math.round(seconds/60/60)) + "H"
    else if (seconds/60/60/24) < 7
        str.tostring(math.round(seconds/60/60/24)) + "D"
    else if (seconds/60/60/24/7) < 4
        str.tostring(math.round(seconds/60/60/24/7)) + "W"
    else if (seconds/60/60/24/30) < 12
        str.tostring(math.round(seconds/60/60/24/30)) + "M"
    else
        str.tostring(math.round(seconds/60/60/24/365)) + "Y"

detectFVG() =>
    bool hasBearishFVG = false
    bool hasBullishFVG = false
    float bearishBottom = na
    float bearishTop = na
    float bullishBottom = na
    float bullishTop = na
    int htfTimeVal = na
    int htfTime2Val = na
    int htfTimeMid = na
    if not na(low[3]) and not na(high[3])
        if high[1] < low[3]
            hasBearishFVG := true
            bearishBottom := high[1]
            bearishTop := low[3]
            htfTimeVal := time[1]
            htfTime2Val := time[3]
            htfTimeMid := time[2]
        if low[1] > high[3]
            hasBullishFVG := true
            bullishBottom := high[3]
            bullishTop := low[1]
            htfTimeVal := time[1]
            htfTime2Val := time[3]
            htfTimeMid := time[2]
    [hasBearishFVG, hasBullishFVG, bearishBottom, bearishTop, bullishBottom, bullishTop, htfTimeVal, htfTime2Val, close[1], htfTimeMid]

del_kz(kz k) =>
    if k._box.size() > max_sessions
        box.delete(k._box.pop())
    if k._hi_line.size() > max_sessions
        line.delete(k._hi_line.pop())
        line.delete(k._lo_line.pop())
        k._hi_valid.pop()
        k._lo_valid.pop()
    if k._hi_label.size() > max_sessions
        label.delete(k._hi_label.pop())
        label.delete(k._lo_label.pop())

adjust_in_kz(kz k, bool t) =>
    if t and k._box.size() > 0
        box kzBox0 = k._box.get(0)
        kzBox0.set_right(time)
        kzBox0.set_top(math.max(kzBox0.get_top(), high))
        kzBox0.set_bottom(math.min(kzBox0.get_bottom(), low))
        if k._hi_line.size() > 0 and k._lo_line.size() > 0
            line hiL = k._hi_line.get(0)
            hiL.set_x2(bar_index)
            if high > hiL.get_y1()
                hiL.set_xy1(bar_index, high)
                hiL.set_xy2(bar_index, high)
            line loL = k._lo_line.get(0)
            loL.set_x2(bar_index)
            if low < loL.get_y1()
                loL.set_xy1(bar_index, low)
                loL.set_xy2(bar_index, low)
        if k._hi_label.size() > 0 and k._lo_label.size() > 0
            label hiLb = k._hi_label.get(0)
            label loLb = k._lo_label.get(0)
            if high > hiLb.get_y()
                hiLb.set_xy(time, high)
            else
                hiLb.set_x(time)
            if low < loLb.get_y()
                loLb.set_xy(time, low)
            else
                loLb.set_x(time)

adjust_out_kz(kz k, bool t) =>
    bool ok = k._box.size() > 0 and k._hi_line.size() > 0 and k._lo_line.size() > 0 and k._hi_label.size() > 0 and k._lo_label.size() > 0 and k._hi_valid.size() > 0 and k._lo_valid.size() > 0
    if not t and ok
        if k._hi_valid.get(0)
            k._hi_line.get(0).set_x2(bar_index)
            k._hi_label.get(0).set_x(time)
            if high >= k._hi_line.get(0).get_y1()
                k._hi_valid.set(0, false)
                k._hi_label.get(0).set_x(nz(time[3], time))
                if alert_sessions
                    alert(k._title + ' High Touched', alert.freq_once_per_bar)
        if k._lo_valid.get(0)
            k._lo_line.get(0).set_x2(bar_index)
            k._lo_label.get(0).set_x(time)
            if low <= k._lo_line.get(0).get_y1()
                k._lo_valid.set(0, false)
                k._lo_label.get(0).set_x(nz(time[3], time))
                if alert_sessions
                    alert(k._title + " Low Touched", alert.freq_once_per_bar)

manage_kz(kz_helper this) =>
    kz k = this._kz
    color c = this.c
    if timeframe.isintraday
        bool t = not na(time("", this.session, this.tz))
        bool t_prev = not na(time("", this.session, this.tz, bars_back = 1))
        if t_prev and not t and k._hi_line.size() > 0
            k.prevHigh := k._hi_line.get(0).get_y1()
            k.prevLow := k._lo_line.get(0).get_y1()
            k.prevHighActive := true
            k.prevLowActive := true
        if t and not t_prev
            k._box.unshift(box.new(time, high, time, low, xloc = xloc.bar_time, border_color = na, bgcolor = ses_bg_on ? this.bg : na, text_color = na, force_overlay = true))
            k._hi_line.unshift(line.new(bar_index, high, bar_index, high, xloc = xloc.bar_index, style = line_style(session_style), color = c, width = session_width, force_overlay = true))
            k._lo_line.unshift(line.new(bar_index, low, bar_index, low, xloc = xloc.bar_index, style = line_style(session_style), color = c, width = session_width, force_overlay = true))
            k._hi_valid.unshift(true)
            k._lo_valid.unshift(true)
            bool show_lbl = session_lbl != "Hide"
